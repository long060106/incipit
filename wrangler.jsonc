{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incipit",
  // The server (worker/index.ts) answers /api/*, each book's own page (/book/<id>), each essay's
  // (/essays/<id>), the daily first line (/daily) and the sitemap; everything else is the built site in ./dist.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/book/*", "/essays/*", "/daily", "/sitemap.xml"]
  },
  // "Sign in with Google": the id of the site's client at Google (it is public). Empty, and the button
  // is not shown. The secret that goes with it, ACCOUNT_SEAL_KEY, is set with `wrangler secret put`.
  "vars": {
    "GOOGLE_CLIENT_ID": "759869963592-d4ga37o2hil65uvnegmj0j43ogoi5qov.apps.googleusercontent.com"
  },
  // Library cards and readers' notebooks. Tables: worker/migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "incipit",
      "database_id": "c3e1c33e-9c4f-4d0f-86f8-06004523f6a1",
      "migrations_dir": "worker/migrations"
    }
  ]
}
