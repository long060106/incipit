{
  "name": "incipit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "test": "node tests/run.mjs",
    "test:api": "node tests/run.mjs --api-only",
    "catalog": "node scripts/fetch-catalog.mjs",
    "covers": "node scripts/fetch-covers.mjs",
    "books": "node scripts/fetch-books.mjs",
    "geo": "node scripts/make-geo.mjs",
    "texts": "node scripts/fetch-texts.mjs",
    "context": "node scripts/fetch-context.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "i18n-iso-countries": "^7.14.0",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.149.0"
  }
}
